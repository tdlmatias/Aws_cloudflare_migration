{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tdlmatias/aws_cloudflare_migration/schemas/zones.schema.json",
  "title": "Cloudflare migration zones document",
  "description": "Deterministic document produced by the converter and consumed by Terraform.",
  "type": "object",
  "required": ["schema_version", "zones"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/zone" }
    }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "required": ["name", "records"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "\\.$" }
        },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/record" }
        }
      }
    },
    "record": {
      "type": "object",
      "required": ["name", "type", "content", "ttl"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["A", "AAAA", "CNAME", "TXT", "MX", "NS"]
        },
        "content": { "type": "string", "minLength": 1 },
        "ttl": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "priority": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 65535
        },
        "proxied": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "MX" } } },
          "then": {
            "properties": { "priority": { "type": "integer" } },
            "required": ["priority"]
          }
        }
      ]
    }
  }
}
